# LLM Provider API Keys (at least one required)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Ollama (local — no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# SGLang (local, faster — see scripts/serve-sglang.sh)
# SGLANG_BASE_URL=http://localhost:30000/v1

# vLLM (local alternative)
# VLLM_BASE_URL=http://localhost:8000/v1

# LLM request tuning (optional)
# LLM_TIMEOUT_MS=120000   # timeout per request (default 120s — raise for slow local models)
# LLM_MAX_TOKENS=4096     # max output tokens (default 4096 — raise for "thinking" models)
# LLM_ENABLE_THINKING=false  # true keeps chain-of-thought for local thinking models (Qwen3); false = faster (default)

# Logging level (optional — default "info")
# silent | error | warn | info | debug. "debug" shows Monte-Carlo trick traces.
# LOG_LEVEL=info

# Distributed tracing (OpenTelemetry → Jaeger via an OTel collector)
# Set OTEL_ENABLED=false to disable tracing entirely.
# OTEL_ENABLED=true
# @vercel/otel exports over OTLP HTTP/protobuf (it has no gRPC exporter), so use
# the collector's HTTP port (4318 on Jaeger all-in-one) and the full /v1/traces path.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://10.0.0.213:4318/v1/traces
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Card-play mode (optional — default "search")
# search | hybrid | llm. Bidding/trump/rebid always use the LLM.
# AGENT_PLAY_MODE=search
# SEARCH_SAMPLES=150    # hidden-deal samples per move (higher = stronger, slower)
# AGENT_EXPLAIN=false   # search only: LLM rewrites the search's Table Talk

# Early concede (optional — default enabled)
# When true, a "Concede" button lets you end the match early if it's clearly lost.
# ALLOW_CONCEDE=true

# Early round resolution (optional — default enabled)
# When true, a "Round decided" prompt lets you stop a round early once the
# outcome is mathematically certain (opponents can't reach their bid).
# ALLOW_EARLY_RESOLVE=true

# Agent Configuration (optional — defaults shown)
# Provider per agent: 'deepseek' | 'openrouter' | 'openai' | 'ollama' | 'sglang' | 'vllm'
# Default model: deepseek-chat
AGENT_PARTNER_PROVIDER=deepseek
AGENT_PARTNER_MODEL=deepseek-chat
AGENT_OPPONENT1_PROVIDER=deepseek
AGENT_OPPONENT1_MODEL=deepseek-chat
AGENT_OPPONENT2_PROVIDER=deepseek
AGENT_OPPONENT2_MODEL=deepseek-chat

# Agent temperature (0.0 = deterministic/risk-averse, 1.0+ = creative/risky)
# Lower values make opponents play safer and more predictably.
AGENT_PARTNER_TEMPERATURE=0.3
AGENT_OPPONENT1_TEMPERATURE=0.4
AGENT_OPPONENT2_TEMPERATURE=0.5

# Agent strategy style (free-text — directly shapes how each AI plays)
AGENT_PARTNER_STRATEGY=Supportive — plays to help partner win tricks. Conservative bidding, cooperative play.
AGENT_OPPONENT1_STRATEGY=Balanced — bid only when your hand genuinely supports the contract; value safe trick-taking over risky overbids.
AGENT_OPPONENT2_STRATEGY=Balanced — mix conservative and aggressive play, but avoid reckless overbids that lose the round.

# App URL (for OpenRouter referrer)
APP_URL=http://localhost:3000


# Tuning
# Value	Effect
# minimal	Fastest — almost no chain-of-thought
# low	Brief reasoning (current setting)
# medium	Default
# high	Most reasoning, slowest
# gpt-oss reasoning effort (SGLang/vLLM only): minimal | low | medium | high.
# Lower = less chain-of-thought = much lower latency (biggest lever for speed).
# WARNING: this is a gpt-oss-20b knob only. Qwen3's chat template ignores it —
# setting it with Qwen3 is a no-op AND disables nothing. For Qwen3, keep this
# commented out and rely on LLM_ENABLE_THINKING=false (the default) instead.
# LLM_REASONING_EFFORT=low